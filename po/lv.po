msgstr[0] "Gaida %(minutes)d minūtes, līdz instalēšana tiks pabeigta."
msgstr[1] "Gaida %(minutes)d minūti, līdz instalēšana tiks pabeigta."
msgstr[2] "Gaida %(minutes)d minūtes, līdz instalēšana tiks pabeigta."

