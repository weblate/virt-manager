#: virtinst/cli.py:635
msgid ""
"Configure guest console auto connect. Example:\n"
"--autoconsole text\n"
"--autoconsole graphical\n"
"--autoconsole none"
msgstr ""
"Konfigurēt viesa konsoles automātisku savienošanu. Piem.:\n"
"--autoconsole text\n"
"--autoconsole graphical\n"
"--autoconsole none"

