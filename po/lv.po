msgid "Print the generated domain XML rather than create the guest."
msgstr "Izvadīt izveidoto domēna XML, nevis izveidot viesi."

#: virtinst/cli.py:685
msgid ""
"Run through install process, but do not create devices or define the guest."
msgstr ""
"Iziet cauri instalēšanas procesam, bet neveidot ierīces un nedefinēt viesi."

#: virtinst/cli.py:693
msgid ""
"Enable or disable validation checks. Example:\n"
"--check path_in_use=off\n"
"--check all=off"
msgstr ""
"Iespējot vai atspējot validācijas pārbaudes. Piem.:\n"
"--check path_in_use=off\n"
"--check all=off"

