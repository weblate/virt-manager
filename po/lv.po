msgstr ""
"Izmantojot --osinfo {osname}, VM veiktspēja var ciest. Optimāliem "
"rezultātiem norādiet precīzu OS."

#: virtinst/virtinstall.py:401
#, python-brace-format
msgid "Using {osname} --location {url}"
msgstr "Izmanto {osname} --location {url}"

#: virtinst/virtinstall.py:484
#, python-brace-format
msgid "Using default --name {vm_name}"
msgstr "Izmanto noklusējuma --name {vm_name}"

#: virtinst/virtinstall.py:495
#, python-brace-format
msgid "Using container default --memory {megabytes}"
msgstr "Izmanto konteinera noklusējuma --memory {megabytes}"

#: virtinst/virtinstall.py:515
#, python-brace-format
msgid "Using {os_name} default --memory {megabytes}"
msgstr "Izmanto {os_name} noklusējuma --memory {megabytes}"

#: virtinst/virtinstall.py:528
#, python-brace-format
msgid "Using {os_name} default --disk {disk_options}"
msgstr "Izmanto {os_name} noklusējuma --disk {disk_options}"

#: virtinst/virtinstall.py:580
#, python-brace-format
msgid ""
"Failed to detect osinfo OS name from install media, using fallback name "
"'{name}'.\n"
"Please file a bug against virt-install if you expected the detection to "
"succeed."
msgstr ""
"Neizdevās noteikt osinfo OS nosaukumu no instalēšanas datu nesēja, tiek "
"izmantots rezerves nosaukums '{name}'.\n"
"Ja gaidījāt, ka noteikšana izdosies, lūdzu, iesniedziet kļūdas ziņojumu par "
"virt-install."

#: virtinst/virtinstall.py:587
#, python-format
msgid "Error validating install location: %s"
msgstr "Kļūda, validējot instalēšanas atrašanās vietu: %s"

#: virtinst/virtinstall.py:589
msgid ""
"--osinfo/--os-variant OS name is required, but no value was\n"
"set or detected."
msgstr ""
"--osinfo/--os-variant OS nosaukums ir nepieciešams, bet vērtība nav\n"
"iestatīta vai noteikta."

#: virtinst/virtinstall.py:600
msgid ""
"This is now a fatal error. Specifying an OS name is required\n"
"for modern, performant, and secure virtual machine defaults.\n"
msgstr ""
"Tagad tā ir fatāla kļūda. OS nosaukuma norādīšana ir nepieciešama\n"
"moderniem, veiktspējīgiem un drošiem virtuālo mašīnu noklusējumiem.\n"

#: virtinst/virtinstall.py:605
msgid ""
"If you expected virt-install to detect an OS name from the\n"
"install media, you can set a fallback OS name with:\n"
"\n"
"  --osinfo detect=on,name=OSNAME\n"
msgstr ""
"Ja gaidījāt, ka virt-install noteiks OS nosaukumu no\n"
"instalēšanas datu nesēja, varat iestatīt rezerves OS nosaukumu ar:\n"
"\n"
"  --osinfo detect=on,name=OSNAME\n"

#: virtinst/virtinstall.py:615
msgid ""
"You can see a full list of possible OS name values with:\n"
"\n"
"   virt-install --osinfo list\n"
msgstr ""
"Pilnu iespējamo OS nosaukumu vērtību sarakstu var redzēt ar:\n"
"\n"
"   virt-install --osinfo list\n"

#: virtinst/virtinstall.py:622
#, python-brace-format
msgid ""
"If your Linux distro is not listed, try one of generic values\n"
"such as: {oslist}\n"
msgstr ""
"Ja jūsu Linux distributīvs nav uzskaitīts, mēģiniet kādu no vispārīgajām "
"vērtībām,\n"
"piemēram: {oslist}\n"

#: virtinst/virtinstall.py:629
#, python-brace-format
msgid ""
"If you just need to get the old behavior back, you can use:\n"
"\n"
"  --osinfo detect=on,require=off\n"
"\n"
"Or export {env_var}=1\n"
msgstr ""
"Ja jums vienkārši jāatgriež vecā darbība, varat izmantot:\n"
"\n"
"  --osinfo detect=on,require=off\n"
"\n"
"Vai eksportējiet {env_var}=1\n"

#: virtinst/virtinstall.py:639
#, python-brace-format
msgid "{env_var} set. Skipping fatal error."
msgstr "{env_var} iestatīts. Fatālā kļūda tiek izlaista."

